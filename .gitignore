# ---- 环境与第三方（不版本化）----
.venv/
yolo-lib/
.idea/
__pycache__/
*.pyc
*.pyo
pip-tmp/
.ignore

# ---- 模型权重 ----
*.pt
*.pth
*.onnx
relabel/weights/
relabel/cfg/

# ---- 数据本体：一律不进 git ----
bike_dataset/
dataset_v2/
dataset_school/
dataset*/
relabel/auto/
images/
labels/
data/

# ---- 训练 / 推理产物（可重新生成）----
runs/
violation_*/
school_infer/
review.html
*.egg-info/

# ---- 媒体与大文件：默认全部忽略 ----
*.jpg
*.jpeg
*.png
*.bmp
*.webp
*.tif
*.tiff
*.gif
*.mp4
*.avi
*.mov
*.mkv
*.zip
*.tar
*.gz
*.7z
*.npy
*.npz

# ---- 例外：仅 docs/images 下的界面截图进 git ----
!docs/images/
!docs/images/*.jpg
!docs/images/*.png
