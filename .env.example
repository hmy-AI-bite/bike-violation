# Copy to .env and set only the values that differ on your machine.
# Existing environment variables take precedence. Relative paths use the repo root.
# Shell variables (${VAR}, %VAR%) are not expanded; path values support ~.
BICYCLE_DATA_ROOT=data
BICYCLE_OUTPUT_ROOT=.
BICYCLE_WEIGHTS_DIR=relabel/weights
BICYCLE_YOLO_LIB=yolo-lib
BICYCLE_SAM2_REPO=vendor/sam2
BICYCLE_SAM2_CHECKPOINT=relabel/weights/sam2.1_hiera_tiny.pt
BICYCLE_SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_t.yaml
